# ---------------------------------------------------------------------------
# LOCAL / CUSTOM EVALUATION EXTENSIONS (IGNORED FROM PUBLIC COMMITS)
# ---------------------------------------------------------------------------
# Custom evaluation plugins, rubrics, and local dataset caches stay local.

# Evaluation plugins (runners + shared engine + rubric registry).
# `gbench/plugins` may be a symlink; git stores a symlink as a file entry, so both the plain
# name and the trailing-slash directory form are listed so either kind matches.
gbench/plugins
gbench/plugins/
plugins/

# Private/local datasets and any local copy of rubric specs.
gbench-data/
docs/eval-rubrics/
**/eval-rubrics/

# Plugin-specific tests only. Tests for the built-in (public) eval suites are NOT ignored;
# plugin tests import gbench.plugins.* and are not part of the public package.
# NOTE: gitignore has no inline comments - a trailing '# ...' becomes part of the pattern.
tests/test_plugin_engine.py
tests/test_plugin*.py
tests/test_rubrics.py
tests/test_*_plugin.py
tests/test_internal_*.py

# Audit reports / local evaluation data / scratch specs - not part of the public package.
docs/EVAL_AUDIT_*
docs/*_findings.json
docs/gemma?-evals/
**/internal/
scripts/fetch_internal_datasets.sh

# Operator scratchpad: known gaps / blocked suites. Deliberately NOT published -
# it tracks the state of this box's runs, not the tool. Per-suite setup lives in
# docs/evals/ instead. (Removed from the repo 2026-08-17.)
docs/PENDING.md

