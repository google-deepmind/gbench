+#: gbench fix (swe-rex 1.4.0 + gbench patch, 2026-10-08): a heredoc operator (`<<`, `<<-`; not
+#: the here-string `<<<`). Splitting a command that holds one with bashlex 0.18 and joining the
+#: pieces with " ; " loses text: the parse ends a command's range before the body of a heredoc
+#: whose operator is not the last word of its line (`cat <<EOF > f`, `python3 - <<EOF 2>&1`,
+#: `cat <<EOF | sh`), and the next command lands on the terminator's line, so the shell waited for
+#: a terminator that never came until the command timed out. Such a command is never split: it
+#: runs whole (_as_single_command).
+_HEREDOC_OPERATOR = re.compile(r"(?<!<)<<(?!<)")
+
+
+def _holds_heredoc(command: str) -> bool:
+    return bool(_HEREDOC_OPERATOR.search(command))
+
+
+def _as_single_command(command: str) -> tuple[str, str]:
+    """(a one-line command that runs `command` whole, the file that carries its text).
+
+    The text goes to a new file, and the session's shell runs `eval "$(cat FILE; rm -f FILE)"`:
+    the shell reads all of it before running any of it and parses it as it parses a script
+    (heredocs included), in the session's shell, so its cd, variables and jobs persist and its
+    exit status is the last command's. The file is gone before the first command runs. One line
+    is sent, so the shell prints one PS1 (what `_run_normal` waits for) and nothing typed ahead
+    can reach a command's stdin. `builtin` and `command -p` keep a function, alias or PATH the
+    session defined from changing the wrapper."""
+    fd, path = tempfile.mkstemp(prefix="swerex-command-", suffix=".sh")
+    with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
+        f.write(command)
+    q = shlex.quote(path)
+    return f'builtin eval "$(command -p cat {q}; command -p rm -f {q})"', path
+
+
+def _join_bash_commands(cmds: list[str]) -> str:
+    """The pieces of _split_bash_command on one line: joined with " ; ", except after a piece
+    that ends with the background operator `&`, which already ends it (`a & ; b` is a syntax
+    error; gbench fix, 2026-10-08)."""
+    out = ""
+    for i, cmd in enumerate(cmds):
+        if i:
+            prev = cmds[i - 1].rstrip()
+            background = prev.endswith("&") and not prev.endswith(("&&", "\\&"))
+            out += " " if background else " ; "
+        out += cmd
+    return out
+
+
