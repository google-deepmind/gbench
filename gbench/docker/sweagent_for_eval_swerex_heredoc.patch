+#: gbench heredoc fix (2026-10-08). The runtime each task container runs is installed by
+#: glibc_dockerfile. Upstream installs the latest `swe-rex` from PyPI there, unpinned; gbench
+#: installs exactly these distributions (swe-rex 1.4.0 and the versions pip resolved for it on
+#: 2026-10-08, without resolving again) and then replaces swe-rex 1.4.0's swerex/runtime/local.py
+#: with this package's own, which carries gbench's heredoc fix (_split_bash_command never splits
+#: a command that holds a heredoc; see swerex/runtime/local.py). The client and every task
+#: container thus run the same session code, checked by sha256 on both sides.
+GBENCH_RUNTIME_PINS = (
+    "swe-rex==1.4.0", "annotated-doc==0.0.5", "annotated-types==0.8.0", "anyio==4.15.1",
+    "bashlex==0.18", "certifi==2026.7.22", "charset-normalizer==3.5.2", "click==8.5.0",
+    "fastapi==0.142.4", "h11==0.16.0", "idna==3.20", "markdown-it-py==4.2.0", "mdurl==0.1.2",
+    "opentelemetry-api==1.45.1", "pexpect==4.9.0", "ptyprocess==0.7.0", "pydantic==2.13.5",
+    "pydantic_core==2.46.5", "Pygments==2.21.0", "python-multipart==0.0.32", "requests==2.34.2",
+    "rich==15.0.0", "starlette==1.7.0", "typing-inspection==0.4.4", "typing_extensions==4.16.0",
+    "urllib3==2.8.0", "uvicorn==0.54.0",
+)
+#: sha256 of swerex/runtime/local.py as swe-rex 1.4.0 ships it (PyPI), and with gbench's fix.
+GBENCH_RUNTIME_LOCAL_UPSTREAM_SHA256 = "d56f22b48b02d4df6644cfa04cc16c979b0498ef1c26058b82fb2d4a60bf9ac7"
+GBENCH_RUNTIME_LOCAL_SHA256 = "d67d68966754cc73a3c2ae084fdfe90e7fb274e3ae36da6e619e1c4155372ed4"
+
+
+def _gbench_runtime_dockerfile_steps() -> str:
+    """The glibc_dockerfile steps that install the pinned runtime and gbench's local.py."""
+    source = Path(__file__).resolve().parent.parent / "runtime" / "local.py"
+    data = source.read_bytes()
+    if hashlib.sha256(data).hexdigest() != GBENCH_RUNTIME_LOCAL_SHA256:
+        msg = f"{source} is not gbench's patched swe-rex 1.4.0 runtime (sha256 mismatch)"
+        raise RuntimeError(msg)
+    payload = base64.b64encode(zlib.compress(data, 9)).decode()
+    install = (
+        "/root/python3.11/bin/python3 -c \""
+        "import base64,hashlib,pathlib,sysconfig,zlib;"
+        "p=pathlib.Path(sysconfig.get_paths()['purelib'],'swerex','runtime','local.py');"
+        f"assert hashlib.sha256(p.read_bytes()).hexdigest()=='{GBENCH_RUNTIME_LOCAL_UPSTREAM_SHA256}',p;"
+        f"b=zlib.decompress(base64.b64decode('{payload}'));"
+        f"assert hashlib.sha256(b).hexdigest()=='{GBENCH_RUNTIME_LOCAL_SHA256}';"
+        "p.write_bytes(b);"
+        "[c.unlink() for c in p.parent.glob('__pycache__/local.*.pyc')]\""
+    )
+    return (
+        f"RUN /root/python3.11/bin/pip3 install --no-cache-dir --no-deps {' '.join(GBENCH_RUNTIME_PINS)}"
+        " && /root/python3.11/bin/pip3 check\n\n"
+        f"RUN {install}\n\n"
+    )
+
